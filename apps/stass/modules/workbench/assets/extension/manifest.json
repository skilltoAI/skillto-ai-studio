{
  "manifest_version": 3,
  "name": "Skillto-AI-Studio",
  "description": "发现当前页视频，下载到本地工作台并整理拉片笔记。",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "webRequest"],
  "optional_permissions": ["downloads"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["http://127.0.0.1/*"], "js": ["workspace-connect.js"], "run_at": "document_idle"}],
  "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
}
