{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studio Motion intake batch v1",
  "type": "object",
  "required": [
    "format",
    "items"
  ],
  "properties": {
    "format": {
      "const": "skillto.motion-intake/1"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "source",
          "sourceUrl",
          "ratio"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "minLength": 1
          },
          "ratio": {
            "type": "string",
            "minLength": 1
          },
          "poster": {
            "type": [
              "string",
              "null"
            ]
          },
          "demo": {
            "type": [
              "string",
              "null"
            ]
          },
          "downloadUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceCommit": {
            "type": [
              "string",
              "null"
            ]
          },
          "availability": {
            "type": [
              "string",
              "null"
            ]
          },
          "width": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "height": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "fps": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "previewOnly": {
            "type": "boolean"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "facet",
                "value",
                "evidence",
                "method"
              ],
              "properties": {
                "facet": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}